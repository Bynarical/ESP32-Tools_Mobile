{
  "expo": {
    "name": "ESP32 OTA",
    "slug": "esp32-ota-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0f14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bynarical.esp32ota"
    },
    "android": {
      "package": "com.bynarical.esp32ota",
      "adaptiveIcon": {
        "backgroundColor": "#0d0f14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "ESP32 OTA uses Bluetooth to find your board and send firmware to it."
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Pretendard-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Pretendard-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Pretendard-Regular.ttf",
              "./assets/fonts/Pretendard-SemiBold.ttf",
              "./assets/fonts/Pretendard-Bold.ttf"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "863fd451-2e29-47b1-affd-8f4515e5129e"
      }
    },
    "owner": "mjk0531"
  }
}
